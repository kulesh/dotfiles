{
  "cleanupPeriodDays": 4098,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "DISABLE_TELEMETRY": "1",
    "USE_BUILTIN_RIPGREP": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(mise:*)",
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git blame:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git remote:*)",
      "Bash(git worktree:*)",
      "Read(~/.zshrc)",
      "Read(**)",
      "Edit(**)",
      "MultiEdit(**)",
      "Edit(~/.cache/**)",
      "MultiEdit(~/.cache/**)",
      "Edit(~/.local/**)",
      "MultiEdit(~/.local/**)",
      "Edit(/tmp/**)",
      "MultiEdit(/tmp/**)",
      "Write(**)",
      "Glob(**)",
      "Grep(**)"
    ],
    "deny": [
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(halt:*)",
      "Bash(init:*)",
      "Bash(poweroff:*)",
      "Bash(mkfs:*)",
      "Bash(dd:*)",
      "Bash(fdisk:*)",
      "Bash(parted:*)",
      "Bash(chown:*)",
      "Bash(chmod 7:*)",
      "Bash(sudo:*)",
      "Bash(doas:*)",
      "Bash(su:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(rsync:*)",
      "Edit(**/.git/hooks/**)",
      "Write(**/.git/hooks/**)",
      "Edit(**/.git/config)",
      "Write(**/.git/config)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(chmod:*)",
      "Bash(kill:*)",
      "Bash(truncate:*)",
      "Bash(git reset --hard:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "WebFetch(domain:*)"
    ]
  },
  "model": "fable[1m]",
  "hooks": {},
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": true,
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowUnixSockets": [
        "/var/run/docker.sock"
      ],
      "allowLocalBinding": true
    },
    "excludedCommands": [
      "git",
      "docker"
    ]
  },
  "effortLevel": "high",
  "companyAnnouncements": [
    "Welcome to Claude Code! (global)"
  ],
  "skipDangerousModePermissionPrompt": true,
  "additionalDirectories": [
    "~/dev/*",
    "~/.local/*",
    "~/.cache/*",
    "/tmp/*"
  ],
  "defaultMode": "plan"
}
