(version 1)

;; =============================================================================
;; Sandbox profile for coding agents - PROJECT SCOPED
;; =============================================================================
;;
;; Philosophy: a deny-list (ADR-002). Agents read broadly and write by default
;; (allow default, at the end). Denied: known secrets, and every file your Mac
;; later runs OUTSIDE the sandbox, so code planted here can't escape it.
;; Seatbelt applies the last matching rule, so an allow-back follows its deny.
;;
;; NOTE: Setuid binaries (ps, top, sudo, su, etc.) blocked by macOS kernel.
;; Use alternatives: pgrep (for ps), htop (for top)
;;
;; Parameters passed via sandbox-exec -D:
;;   HOME        - user home directory
;;   PROJECT - current project directory
;;   SSH_REAL    - real path to ~/.ssh (resolving symlinks)

;; =============================================================================
;; PARAMETERS
;; =============================================================================

(define HOME (param "HOME"))
(define PROJECT (param "PROJECT"))
(define SSH_REAL (param "SSH_REAL"))

;; =============================================================================
;; FILE READS
;; =============================================================================

;; Allow reading everything by default
(allow file-read* (subpath "/"))

;; Deny regular files under SSH_REAL (allows directory traversal)
(deny file-read*
    (require-all
        (subpath SSH_REAL)
        (vnode-type REGULAR-FILE)))

;; Allow back specific SSH files needed for git
(allow file-read* (literal (string-append SSH_REAL "/known_hosts")))
(allow file-read* (literal (string-append SSH_REAL "/config")))

;; Allow public keys (explicit list since regex in require-all doesn't work)
(allow file-read* (literal (string-append SSH_REAL "/id_rsa.pub")))
(allow file-read* (literal (string-append SSH_REAL "/id_ed25519.pub")))
(allow file-read* (literal (string-append SSH_REAL "/id_ecdsa.pub")))
(allow file-read* (literal (string-append SSH_REAL "/id_dsa.pub")))

;; Deny other secrets
(deny file-read* (subpath (string-append HOME "/.aws")))
(deny file-read* (literal (string-append HOME "/.netrc")))
(deny file-read* (subpath (string-append HOME "/.gnupg/private-keys-v1.d")))
;; Allowing keychain reads - needed for git credential-osxkeychain helper.
;; Blocking this causes a confusing macOS "Keychain Not Found" dialog on startup.
;; (deny file-read* (subpath (string-append HOME "/Library/Keychains")))
(deny file-read* (subpath (string-append HOME "/Library/Application Support/Google/Chrome")))
(deny file-read* (subpath (string-append HOME "/Library/Application Support/Firefox")))
(deny file-read* (subpath (string-append HOME "/Library/Safari")))

;; =============================================================================
;; FILE WRITES - allowed by default; denied where your Mac would run them later
;; =============================================================================
;; Symlinks resolve to real paths, so a linked file is denied by its path in
;; ~/.dotfiles. Still open, by design or for lack of a cheap rule: the two
;; agent settings files (Claude Code's hooks and statusLine, Pi's packages run
;; on your Mac; changing settings from inside needs them writable),
;; ~/.claude/plugins, tools installed under ~/.local/share (mise's included),
;; and mise configs nested inside the project (packages/x/.mise.toml). devvm
;; closes those with a VM; see ADR-002.

;; Shell startup files, zsh's completion dump (compinit sources it), and login
;; items
(deny file-write* (literal (string-append HOME "/.zshrc")))
(deny file-write* (literal (string-append HOME "/.zshenv")))
(deny file-write* (literal (string-append HOME "/.zprofile")))
(deny file-write* (literal (string-append HOME "/.zlogin")))
(deny file-write* (literal (string-append HOME "/.zlogout")))
(deny file-write* (literal (string-append HOME "/.bashrc")))
(deny file-write* (literal (string-append HOME "/.bash_profile")))
(deny file-write* (literal (string-append HOME "/.profile")))
(deny file-write* (subpath (string-append HOME "/Library/LaunchAgents")))
(deny file-write* (literal (string-append HOME "/.zcompdump")))
(deny file-write* (literal (string-append HOME "/.zcompdump.zwc")))

;; The dotfiles checkout: shell libraries, mise config and tasks, bootstrap,
;; dsync, this profile, its .git. Only the two agent settings files linked
;; into it stay writable: a new file there would be linked into your home by
;; the next bootstrap, and dsync would carry it to your other Macs.
(deny file-write* (subpath (string-append HOME "/.dotfiles")))
(allow file-write* (literal (string-append HOME "/.dotfiles/claude/.claude/settings.json")))
(allow file-write* (literal (string-append HOME "/.dotfiles/pi/.pi/agents/settings.json")))

;; ~/dev: only this project. Other repos' git hooks and mise configs, org
;; configs and the shared ~/dev/.mise.toml all run on your Mac, unprompted
;; for repos mise trusts (ADR-014).
(deny file-write* (subpath (string-append HOME "/dev")))
(allow file-write* (subpath PROJECT))

;; Configs that make a tool run commands: mise tasks and hooks, git hooks and
;; aliases, gh shell aliases, starship custom modules, ghostty's command,
;; Homebrew's tap trust, nvim and yazi plugins, and the sandbox's profiles
(deny file-write* (literal (string-append HOME "/.gitconfig")))
(deny file-write* (subpath (string-append HOME "/.config/mise")))
(deny file-write* (subpath (string-append HOME "/.config/git")))
(deny file-write* (subpath (string-append HOME "/.config/gh")))
(deny file-write* (subpath (string-append HOME "/.config/starship")))
(deny file-write* (subpath (string-append HOME "/.config/ghostty")))
(deny file-write* (subpath (string-append HOME "/.config/homebrew")))
(deny file-write* (subpath (string-append HOME "/.config/nvim")))
(deny file-write* (subpath (string-append HOME "/.config/yazi")))
(deny file-write* (subpath (string-append HOME "/.config/sandbox")))
(deny file-write* (subpath (string-append HOME "/.config/colima")))   ; ~/.ssh/config includes its ssh_config

;; Commands on your PATH outside the sandbox
(deny file-write* (subpath (string-append HOME "/.local/bin")))
(deny file-write* (subpath "/usr/local"))

;; The project's git hooks and config, and .git itself (swapped for a file
;; pointing elsewhere, its hooks would escape these rules): your next git
;; command outside the sandbox would run what they name. Commits, branches and
;; fetches still work; git push -u can't record the upstream, so push without
;; -u here.
(deny file-write* (literal (string-append PROJECT "/.git")))
(deny file-write* (subpath (string-append PROJECT "/.git/hooks")))
(deny file-write* (literal (string-append PROJECT "/.git/config")))

;; The project's mise config: mise loads it unprompted (ADR-014), and it can
;; run commands. Change tools outside the sandbox (mise use).
(deny file-write* (literal (string-append PROJECT "/.mise.toml")))
(deny file-write* (literal (string-append PROJECT "/mise.toml")))
(deny file-write* (literal (string-append PROJECT "/.mise.local.toml")))
(deny file-write* (literal (string-append PROJECT "/mise.local.toml")))
(deny file-write* (literal (string-append PROJECT "/.tool-versions")))
(deny file-write* (literal (string-append PROJECT "/.config/mise.toml")))
(deny file-write* (subpath (string-append PROJECT "/.config/mise")))
(deny file-write* (literal (string-append PROJECT "/.mise/config.toml")))
(deny file-write* (literal (string-append PROJECT "/mise/config.toml")))

;; Keys and credentials
(deny file-write* (subpath (string-append HOME "/.ssh")))
(deny file-write* (subpath (string-append HOME "/.gnupg")))
(deny file-write* (subpath (string-append HOME "/.aws")))

;; Block system directory writes
(deny file-write* (subpath "/System"))
(deny file-write* (subpath "/usr"))
(deny file-write* (subpath "/bin"))
(deny file-write* (subpath "/sbin"))
(deny file-write* (subpath "/Library"))
(deny file-write* (subpath "/Applications"))
(deny file-write* (subpath "/opt/homebrew"))

;; =============================================================================
;; EVERYTHING ELSE - Allow by default
;; =============================================================================

(allow default)
