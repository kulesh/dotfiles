#!/usr/bin/env zsh
# secret — API keys and tokens in the macOS login Keychain
#
#   secret set NAME     store a value (prompted, so it never appears in argv or history)
#   secret get NAME     print a value (nothing, if this Mac doesn't have it)
#   secret rm NAME      delete
#   secret ls           list stored names
#   secret import FILE  store every entry of a flat JSON object, e.g. ~/dev/.keys.json
#
# A project receives only the secrets it names in its own .mise.toml:
#   ANTHROPIC_API_KEY = "{{ exec(command='secret get ANTHROPIC_API_KEY') }}"
# Items live in the login keychain on this Mac only.
set -euo pipefail

service=dotfiles

usage() { sed -n '2,8s/^# \{0,1\}//p' "$0" >&2; exit 2; }
valid() { [[ $1 =~ '^[A-Z_][A-Z0-9_]*$' ]] || { echo "secret: '$1' isn't a valid variable name" >&2; exit 2; }; }

names() {
    # Attributes only; dump-keychain without -d never reads secret data.
    security dump-keychain 2>/dev/null | awk -v want="\"svce\"<blob>=\"$service\"" '
        /^keychain:/                      { acct = "" }
        /"acct"<blob>="/                  { acct = $0; sub(/.*"acct"<blob>="/, "", acct); sub(/"$/, "", acct) }
        index($0, want) && acct != ""     { print acct }
    ' | sort -u
}

cmd=${1:-}; (( $# )) && shift
case $cmd in
    set)
        (( $# == 1 )) || usage; valid "$1"
        security add-generic-password -U -s "$service" -a "$1" -w   # -w last: prompt for the value
        ;;
    get)
        (( $# == 1 )) || usage
        # A key this Mac doesn't have (security's 44) is an empty value, not
        # an error: one missing key mustn't stop mise loading a project's
        # other keys and its tools. bootstrap lists the keys projects name
        # that this Mac lacks. Any other failure is asked again, to show why.
        if value=$(security find-generic-password -s "$service" -a "$1" -w 2>/dev/null); then
            print -r -- "$value"
        elif (( $? != 44 )); then
            security find-generic-password -s "$service" -a "$1" -w >/dev/null
        fi
        ;;
    rm)
        (( $# == 1 )) || usage
        security delete-generic-password -s "$service" -a "$1" >/dev/null
        ;;
    ls)
        names
        ;;
    import)
        (( $# == 1 )) || usage
        /usr/bin/python3 -I -c '
import json, sys
for k, v in json.load(open(sys.argv[1])).items():
    print(k, v, sep="\t")' "$1" | while IFS=$'\t' read -r name value; do
            valid "$name"
            # Non-interactive, so the value is briefly in this process's argv.
            security add-generic-password -U -s "$service" -a "$name" -w "$value"
            echo "stored $name"
        done
        ;;
    *)
        usage
        ;;
esac
