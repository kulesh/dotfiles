#!/usr/bin/env zsh
#MISE description="List the templates mkproject can start from (list_project_types)"
#MISE quiet=true
set -euo pipefail
source "${0:A:h}/_lib.zsh"

print "Templates (mkproject <name> <template>):"
for name in ${(f)"$(template_names)"}; do
    print -r -- "  ${(r:12:)name} $(sed -n 's/^#MISE description="\(.*\)"$/\1/p' "$templates_dir/$name.sh")"
done
