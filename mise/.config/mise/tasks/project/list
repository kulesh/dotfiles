#!/usr/bin/env zsh
#MISE description="List the projects in ~/dev, by org (lsprojects)"
#MISE quiet=true
#USAGE flag "--type <type>" help="Only cloned or created projects" {
#USAGE   choices "cloned" "created"
#USAGE }
#USAGE flag "--tools" help="Show each project's mise tools"
#USAGE flag "--names" hide=#true help="org/repo, one per line (for the picker)"
#USAGE flag "--short" hide=#true help="Shortest unambiguous names, one per line (for completion)"
#USAGE flag "--orgs" hide=#true help="With --short, each org too, as org/ (for updateproject's completion)"
set -euo pipefail
source "${0:A:h}/_lib.zsh"

if [[ ${usage_names:-false} == true ]]; then project_names; exit 0; fi
if [[ ${usage_short:-false} == true ]]; then
    if [[ ${usage_orgs:-false} == true ]]; then print -rl -- ${^${(u)${(f)"$(project_names)"}%%/*}}/; fi
    project_short_names
    exit 0
fi

typeset -A count=(cloned 0 created 0 sandboxed 0)
orgs=()
print -r -- "${c[bold]}Projects${c[reset]} ${c[dim]}in $projects_dir${c[reset]}"

for name in ${(f)"$(project_names)"}; do
    dir=$projects_dir/$name org=${name%%/*} repo=${name#*/}
    if slug=$(github_slug "$dir"); then
        kind=cloned origin="${c[green]}↙ $slug${c[reset]}"
    else
        kind=created origin="${c[yellow]}✦ local${c[reset]}"
    fi
    [[ -n ${usage_type:-} && $usage_type != $kind ]] && continue
    if [[ $org != ${orgs[-1]:-} ]]; then
        orgs+=("$org")
        print
        print -r -- "${c[bold]}$org${c[reset]}"
    fi
    (( count[$kind]++ )) || true
    lock="  "
    if [[ -f $dir/.sandbox ]]; then lock="🔒"; (( count[sandboxed]++ )) || true; fi
    printf "  ${c[cyan]}%-24s${c[reset]} %s %s ${c[dim]}%s${c[reset]}\n" "$repo" "$lock" "$origin" "$(last_modified "$dir")"
    if [[ ${usage_tools:-false} == true ]]; then
        mise -C "$dir" ls --current 2>/dev/null | sed 's/^/      /'
    fi
done

print
total=$(( count[cloned] + count[created] ))
if (( total == 0 )); then
    print -r -- "No ${usage_type:+$usage_type }projects"
else
    (( $#orgs == 1 )) && in="1 org" || in="$#orgs orgs"
    print -r -- "$total projects in $in: ${count[cloned]} cloned, ${count[created]} created, ${count[sandboxed]} sandboxed"
fi
