#!/usr/bin/env zsh
#MISE description="Pull the latest changes for a cloned project (updateproject)"
#MISE quiet=true
#MISE raw=true
#USAGE arg "[name]" help="org/repo, or a repo name one org has (default: the one you're in)"
#USAGE complete "name" run="mise run project:list --short"
#USAGE flag "--from <dir>" hide=#true help="Directory the command was run from"
set -euo pipefail
source "${0:A:h}/_lib.zsh"

if [[ -n ${usage_name:-} ]]; then
    dir=$(project_dir "$usage_name") || exit 1
else
    dir=$(project_root "${usage_from:-$PWD}") || die "Not in a project; name one: updateproject <name>"
fi
cd "$dir"
name=$(project_label "$dir")

[[ -d .git ]] || die "$name isn't a git repository"
branch=$(git branch --show-current)
[[ -n $branch ]] || die "$name isn't on a branch"
# The branch's own upstream, wherever it points (origin/main, upstream/main).
upstream=$(git rev-parse -q --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null) ||
    die "$name's branch $branch has no upstream to pull from (git branch -u <remote>/<branch>)"
if [[ -n $(git status --porcelain --untracked-files=no) ]]; then
    git status --short --untracked-files=no >&2
    die "$name has uncommitted changes; commit or stash them first"
fi

print -r -- "Updating $name from $upstream"
git fetch -q "${upstream%%/*}"
incoming=$(git rev-list --count 'HEAD..@{upstream}')
if (( incoming == 0 )); then
    print -r -- "Already up to date"
    exit 0
fi
git log --oneline 'HEAD..@{upstream}' | head -10
confirm "Pull $incoming commit(s)? [Y/n]" y || { print "Cancelled"; exit 0; }
git merge -q --ff-only '@{upstream}' || die "$name has diverged from $upstream; merge or rebase it yourself"
print -r -- "Updated $name"
