#!/usr/bin/env zsh
#MISE description="Pull the latest changes for a cloned project, or every repo in an org (updateproject)"
#MISE quiet=true
#MISE raw=true
#USAGE arg "[name]" help="org/repo, a repo name one org has, or org/ for every repo in it (default: the project or org you're in)"
#USAGE complete "name" run="mise run project:list --short --orgs"
set -euo pipefail
source "${0:A:h}/_lib.zsh"

# Bring repos up to date, fast-forward only: fetch them all, show what each
# would do, ask once, fast-forward. A fetch never touches a branch or its
# files, so every repo with an upstream is fetched; uncommitted changes or
# history of its own only keep a repo from moving. One repo shows the
# commits coming and stops at what blocks it; an org shows a table and
# leaves blocked repos as they are.
update() {   # update <what> <repo dir>...
    local what=$1 dir failed line
    shift
    local -a repos=($@) ready=() behind=() stuck=()
    local -A why incoming   # repo dir -> what keeps it from moving / commits coming

    for dir in $repos; do
        if [[ ! -e $dir/.git ]]; then why[$dir]="isn't a git repository"
        elif [[ -z $(git -C "$dir" branch --show-current) ]]; then why[$dir]="isn't on a branch"
        elif ! git -C "$dir" rev-parse -q --verify '@{upstream}' &>/dev/null; then
            why[$dir]="has no upstream to pull from (git branch -u <remote>/<branch>)"
        else ready+=("$dir"); fi
    done

    # Eight fetches at a time: GitHub turns away a burst of SSH connections.
    # A plain fetch fetches the branch's own remote.
    (( $#ready > 1 )) && print -r -- "Fetching ${#ready} repo(s) in $what"
    failed=$(mktemp "${TMPDIR:-/tmp}/updateproject.XXXXXX")
    trap "rm -f ${(q)failed}" EXIT
    local -i n=0
    for dir in $ready; do
        { git -C "$dir" fetch -q 2>/dev/null || print -r -- "$dir" >> "$failed" } &
        (( ++n % 8 )) || wait
    done
    wait
    local -a fetch_failed=(${(f)"$(<$failed)"})

    for dir in $ready; do
        if (( ${fetch_failed[(Ie)$dir]} )); then why[$dir]="couldn't fetch"; continue; fi
        incoming[$dir]=$(git -C "$dir" rev-list --count 'HEAD..@{upstream}')
        (( incoming[$dir] )) || continue
        if (( $(git -C "$dir" rev-list --count '@{upstream}..HEAD') )); then
            why[$dir]="has diverged from its upstream; merge or rebase it yourself"
        elif [[ -n $(git -C "$dir" status --porcelain --untracked-files=no) ]]; then
            why[$dir]="has uncommitted changes; commit or stash them, then run updateproject again"
        else
            behind+=("$dir")
        fi
    done

    if (( $#repos == 1 )); then
        dir=$repos[1]
        (( ${incoming[$dir]:-0} )) && git -C "$dir" log --oneline 'HEAD..@{upstream}' | head -10
        [[ -n ${why[$dir]:-} ]] && die "$what ${why[$dir]}"
        (( $#behind )) || { print -r -- "$what is up to date"; return 0; }
        confirm "Pull ${incoming[$dir]} commit(s)? [Y/n]" y || { print "Cancelled"; return 0; }
    else
        local -i width=0
        for dir in $repos; do (( ${#dir:t} > width )) && width=${#dir:t}; done
        for dir in ${(o)repos}; do
            line=
            (( ${incoming[$dir]:-0} )) && line="${c[green]}${incoming[$dir]} new commit(s)${c[reset]}"
            [[ -n ${why[$dir]:-} ]] && line+="${line:+, }${c[yellow]}skipped${c[reset]}: ${why[$dir]%%[;(]*}"
            print -r -- "  ${(r:width:)${dir:t}}  ${line:-${c[dim]}up to date${c[reset]}}"
        done
        (( $#behind )) || { print -r -- "Nothing to update in $what"; return 0; }
        confirm "Fast-forward ${#behind} repo(s)? [Y/n]" y || { print "Cancelled"; return 0; }
    fi

    for dir in $behind; do
        git -C "$dir" merge -q --ff-only '@{upstream}' 2>/dev/null || stuck+=("${dir:t}")
    done
    (( $#stuck == 0 )) || die "Could not fast-forward: ${(j:, :)stuck}"
    if (( $#repos == 1 )); then print -r -- "Updated $what"; else print -r -- "Updated ${#behind} repo(s) in $what"; fi
}

org_update() {   # org_update <org dir>
    local dir
    local -a repos=()
    for dir in $1/*(N/); do is_project "$dir" && repos+=("$dir"); done
    (( $#repos )) || { print -r -- "No projects in ${1:t}"; return 0; }
    update "${1:t}" $repos
}

if [[ ${usage_name:-} == */ ]]; then
    org=${${usage_name%/}:l}
    valid_name "$org" || die "Not an org name: $usage_name"
    [[ -d $projects_dir/$org ]] || die "No org '$org' in $projects_dir"
    org_update "$projects_dir/$org"
elif [[ -n ${usage_name:-} ]]; then
    dir=$(project_dir "$usage_name") || exit 1
    update "$(project_label "$dir")" "$dir"
elif dir=$(project_root "$here"); then
    update "$(project_label "$dir")" "$dir"
elif [[ ${here:A:h} == ${projects_dir:A} ]] && valid_name "${here:A:t}"; then
    org_update "${here:A}"
else
    die "Not in a project or an org; name one: updateproject <name>, or <org>/ for all its repos"
fi
