#!/usr/bin/env zsh
#MISE description="Go to a project in ~/dev, optionally in the sandbox (workon)"
#MISE quiet=true
#USAGE arg "[name]" help="Project in ~/dev; without one, pick it with fzf"
#USAGE complete "name" run="mise run project:list --names"
#USAGE flag "-s --sandbox" help="Always open this project in the macOS sandbox"
set -euo pipefail
source "${0:A:h}/_lib.zsh"

name=${usage_name:-}
if [[ -z $name ]]; then
    [[ -t 0 ]] && (( $+commands[fzf] )) || die "Usage: workon <name> [-s]   (lsprojects lists them)"
    # Escape or Ctrl-C in the picker goes nowhere, quietly.
    name=$(project_names | fzf --height=40% --reverse --prompt="workon> ") || exit 0
fi
dir=$(project_dir "$name") || exit 1
# The marker is permanent: the shell enters the sandbox whenever it arrives
# in this project (lib/sandbox.sh), not only through workon.
if [[ ${usage_sandbox:-false} == true && ! -f $dir/.sandbox ]]; then
    touch "$dir/.sandbox"
    print -r -- "Sandbox enabled for $name"
fi
follow "$dir"
