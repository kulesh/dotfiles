Include ~/.config/colima/ssh_config

Host github.com
  # Hybrid post-quantum key exchange only: GitHub offers it, and a recording
  # of the session can't be decrypted later by a quantum computer (ADR-015).
  KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com
  # This Mac's auth key, in the Secure Enclave (ADR-015); the old file key
  # until bootstrap retires it, its passphrase in the agent (.zshrc). No
  # UseKeychain: it looks every identity file up in the Keychain before
  # connecting, and hung there on the enclave handle.
  SecurityKeyProvider /usr/lib/ssh-keychain.dylib
  IdentityFile ~/.ssh/id_enclave_auth
  IdentityFile ~/.ssh/id_ed25519
  # Exactly the host keys GitHub publishes, recorded by bootstrap: nothing
  # is trusted on first use.
  UserKnownHostsFile ~/.ssh/known_hosts.d/github
  StrictHostKeyChecking yes
