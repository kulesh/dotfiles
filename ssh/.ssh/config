Include ~/.config/colima/ssh_config

Host github.com
  # Hybrid post-quantum key exchange only: GitHub offers it, and a recording
  # of the session can't be decrypted later by a quantum computer (ADR-015).
  KexAlgorithms mlkem768x25519-sha256,sntrup761x25519-sha512@openssh.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
  StrictHostKeyChecking accept-new
