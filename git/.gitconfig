[user]
	name = Kulesh Shanmugasundaram
	email = 164083+kulesh@users.noreply.github.com
	signingkey = ~/.ssh/id_enclave_sign.pub

# Sign every commit and tag with this Mac's signing key, in the Secure Enclave
# (ADR-015), through ssh-agent; bootstrap makes it, registers it on GitHub for
# signing, and writes allowed_signers for local verification.
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true

[core]
	editor = vim
	pager = delta
	whitespace = trailing-space,space-before-tab,cr-at-eol

[alias]
	last = cat-file commit HEAD
	st = status
	ci = commit
	co = checkout
	sme = shortlog -sn

[format]
	pretty = oneline

[credential]
	helper = osxkeychain
[init]
	defaultBranch = main

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true  # use n and N to move between diff sections
    dark = true      # or light = true, or omit for auto-detection

# Replay local commits on top of the remote instead of merging, so two
# machines committing to the same branch don't diverge on pull.
[pull]
	rebase = true
[rebase]
	autoStash = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true

# Clones over HTTPS (mise.sh clones the dotfiles before GitHub login) push
# over SSH, with the key bootstrap uploads.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/

[merge]
    conflictstyle = zdiff3
