#!/usr/bin/env zsh
#MISE description="Set up GitHub and commit signing, install Claude Code, clone your repos"
#MISE raw=true  # interactive steps (GitHub login, installers) need the terminal
set -euo pipefail

# This file lives at <repo>/.mise/tasks/bootstrap
dotfiles=${0:A:h:h:h}
source "$dotfiles/include/shared_vars.sh"

# mise has already linked the dotfiles (.mise.toml, ADR-010). The steps
# below act on the machine. Run against a HOME other than this account's
# (mise run preview), they're printed instead of executed.
previewing() { [[ $HOME != ${~:-"~$(id -un)"} ]]; }
run() { if previewing; then echo "would run: $*"; else "$@"; fi; }

# mise resolved [tools] before linking ~/.config/mise, so a fresh Mac
# installs the global tools from a fresh process now.
run mise install

# Check the install path too: mise.sh runs in bash, where ~/.local/bin
# isn't on PATH, so command -v alone would reinstall on every run.
command -v claude &>/dev/null || [[ -x $HOME/.local/bin/claude ]] ||
    run sh -c 'curl -fsSL https://claude.ai/install.sh | bash'

if [[ $OSTYPE == darwin* ]]; then
    screenshots=$HOME/Pictures/Screenshots
    # Terminal may lack permission to ~/Pictures; skip quietly if so.
    if run mkdir -p "$screenshots" 2>/dev/null; then
        run defaults write com.apple.screencapture location "$screenshots"
    fi
fi

# A developer machine should be ready to push. gh's login flow generates
# ~/.ssh/id_ed25519 if it's missing, uploads it, and sets git to use SSH.
# Already logged in but no key (e.g. a reinstall): make one and upload it.
key=$HOME/.ssh/id_ed25519
if ! gh auth status &>/dev/null; then
    # The extra scope lets the signing step below register the same key.
    run gh auth login --hostname github.com --git-protocol ssh --web --scopes admin:ssh_signing_key
elif [[ ! -f $key ]]; then
    run ssh-keygen -t ed25519 -f "$key" -C "$(id -un)@$(hostname -s)"
    run gh ssh-key add "$key.pub" --title "$(hostname -s)"
fi

# Git signs commits and tags with this key (.gitconfig). ssh-keygen does the
# signing and only asks the agent, so on macOS keep the passphrase in the
# Keychain and the key in the agent; .zshrc reloads it after a reboot. Then
# editors, coding agents, and sandboxed shells can sign without a prompt.
if [[ $OSTYPE == darwin* && -f $key.pub ]] && ! ssh-add -L 2>/dev/null | grep -qF "$(cut -d' ' -f2 "$key.pub")"; then
    run /usr/bin/ssh-add --apple-use-keychain "$key"
fi

# GitHub marks a commit Verified only if the key is registered for signing,
# which is separate from authentication and needs its own token scope.
if gh auth status &>/dev/null && [[ -f $key.pub ]]; then
    signing_keys() { gh api user/ssh_signing_keys --jq '.[].key' 2>/dev/null; }
    if ! signing_keys >/dev/null; then
        run gh auth refresh --hostname github.com --scopes admin:ssh_signing_key
    fi
    if ! signing_keys | grep -qxF "$(cut -d' ' -f1,2 "$key.pub")"; then
        run gh ssh-key add "$key.pub" --type signing --title "$(hostname -s) signing"
    fi
    # git log --show-signature trusts every key you've registered for
    # signing, so commits made on your other machines verify here too.
    allowed=$HOME/.config/git/allowed_signers
    if previewing; then
        echo "would write $allowed"
    else
        mkdir -p "${allowed:h}"
        signing_keys | sed "s|^|$(git config --get user.email) namespaces=\"git\" |" > "$allowed"
    fi
fi

# Clone your own repos (no forks, no archived) into ~/dev as managed
# projects. Each runs in its own zsh so one bad repo is reported, not fatal.
if gh auth status &>/dev/null; then
    self=$(git -C "$dotfiles" remote get-url origin 2>/dev/null || true)
    failed=()
    for repo in ${(f)"$(gh repo list --source --no-archived --limit 1000 --json nameWithOwner --jq '.[].nameWithOwner')"}; do
        [[ ${self%.git} == *[:/]$repo ]] && continue   # already at ~/.dotfiles
        [[ -d $PROJECT_DIR/${repo#*/} ]] && continue
        if previewing; then echo "would clone $repo"; continue; fi
        zsh -c 'source "$1/lib/misewrapper.sh" && cloneproject gh "$2"' _ "$dotfiles" "$repo" ||
            failed+=("$repo")
    done
    if (( ${#failed} )); then echo "Could not clone: ${failed[*]}"; fi
else
    echo "would clone your GitHub repos into $PROJECT_DIR"
fi

# Secrets live in this Mac's Keychain, entered once per machine. Read-only
# check, so it runs in test runs too.
if [[ $OSTYPE == darwin* ]]; then
    missing=()
    for name in ${(f)"$(grep -v '^#' "$dotfiles/include/secrets" | grep .)"}; do
        "$dotfiles/bin/.local/bin/secret" get "$name" &>/dev/null || missing+=("$name")
    done
    if (( ${#missing} )); then echo "Missing secrets: ${missing[*]}  (add each with: secret set NAME)"; fi
fi
