#!/usr/bin/env zsh
#MISE description="Set up GitHub and commit signing, install Claude Code, clone your repos"
#MISE raw=true  # interactive steps (GitHub login, installers) need the terminal
set -euo pipefail

# This file lives at <repo>/.mise/tasks/bootstrap
dotfiles=${0:A:h:h:h}
source "$dotfiles/include/shared_vars.sh"

# mise has already linked the dotfiles (.mise.toml, ADR-010). The steps
# below act on the machine. Run against a HOME other than this account's
# (mise run preview), they're printed instead of executed.
previewing() { [[ $HOME != ${~:-"~$(id -un)"} ]]; }
run() { if previewing; then echo "would run: $*"; else "$@"; fi; }

# mise resolved [tools] before linking ~/.config/mise, so a fresh Mac
# installs the global tools from a fresh process now.
run mise install

# Check the install path too: mise.sh runs in bash, where ~/.local/bin
# isn't on PATH, so command -v alone would reinstall on every run.
command -v claude &>/dev/null || [[ -x $HOME/.local/bin/claude ]] ||
    run sh -c 'curl -fsSL https://claude.ai/install.sh | bash'

if [[ $OSTYPE == darwin* ]]; then
    screenshots=$HOME/Pictures/Screenshots
    # Terminal may lack permission to ~/Pictures; skip quietly if so.
    if run mkdir -p "$screenshots" 2>/dev/null; then
        run defaults write com.apple.screencapture location "$screenshots"
    fi
fi

# A developer machine should be ready to push. gh's login flow generates
# ~/.ssh/id_ed25519 if it's missing, uploads it, and sets git to use SSH.
# Already logged in but no key (e.g. a reinstall): make one and upload it.
key=$HOME/.ssh/id_ed25519
if ! gh auth status &>/dev/null; then
    # The extra scope lets the signing step below register the same key.
    run gh auth login --hostname github.com --git-protocol ssh --web --scopes admin:ssh_signing_key
elif [[ ! -f $key ]]; then
    run ssh-keygen -t ed25519 -f "$key" -C "$(id -un)@$(hostname -s)"
    run gh ssh-key add "$key.pub" --title "$(hostname -s)"
fi

# Git signs commits and tags with this key (.gitconfig). ssh-keygen does the
# signing and only asks the agent, so on macOS keep the passphrase in the
# Keychain and the key in the agent; .zshrc reloads it after a reboot. Then
# editors, coding agents, and sandboxed shells can sign without a prompt.
if [[ $OSTYPE == darwin* && -f $key.pub ]] && ! ssh-add -L 2>/dev/null | grep -qF "$(cut -d' ' -f2 "$key.pub")"; then
    run /usr/bin/ssh-add --apple-use-keychain "$key"
fi

# GitHub marks a commit Verified only if the key is registered for signing,
# which is separate from authentication and needs its own token scope.
if gh auth status &>/dev/null && [[ -f $key.pub ]]; then
    signing_keys() { gh api user/ssh_signing_keys --jq '.[].key' 2>/dev/null; }
    if ! signing_keys >/dev/null; then
        run gh auth refresh --hostname github.com --scopes admin:ssh_signing_key
    fi
    if ! signing_keys | grep -qxF "$(cut -d' ' -f1,2 "$key.pub")"; then
        run gh ssh-key add "$key.pub" --type signing --title "$(hostname -s) signing"
    fi
    # git log --show-signature trusts every key you've registered for
    # signing, so commits made on your other machines verify here too.
    allowed=$HOME/.config/git/allowed_signers
    if previewing; then
        echo "would write $allowed"
    else
        mkdir -p "${allowed:h}"
        # Fetched first: a failed fetch leaves the old file, not an empty one.
        keys=$(signing_keys)
        print -r -- "$keys" | sed "s|^|$(git config --get user.email) namespaces=\"git\" |" > "$allowed"
    fi
fi

# Projects left in the flat layout, ~/dev/<repo>, from before ADR-013: the
# same rule as project:migrate uses, so the two never disagree.
source "$dotfiles/mise/.config/mise/tasks/project/_lib.zsh"
flat=(${(f)"$(flat_projects)"})
if (( ${#flat} )); then
    echo "${#flat} project(s) in ~/dev/<repo> predate ~/dev/<org>/<repo>. Move them: mise -C / run project:migrate --dry-run"
fi

# Before ADR-013 dropped monorepo mode, the project commands wrote this
# ~/dev/<org>/mise.toml into every org. Remove it while it's unedited; one
# you've changed is yours. (Once every Mac has run this, it can go.)
generated_org_config() {   # generated_org_config <org>
    cat <<EOF
# The $1 projects, one repo each, as a mise monorepo:
#   mise run '//...:test'     runs test in every $1 repo
#   mise run //<repo>:test    runs it in one, from anywhere in $1
# Tools and [env] here reach every $1 repo.
monorepo_root = true

[monorepo]
config_roots = ["*"]
EOF
}
for config in $PROJECT_DIR/*/mise.toml(N.); do
    if [[ "$(<$config)" == "$(generated_org_config ${config:h:t})" ]]; then run rm "$config"; fi
done

# Trust: mise loads a project's config without asking only for repos you or
# your GitHub orgs own (~/dev/<owner>/...); anyone else's clone asks first,
# since a config can run commands. Per Mac, as the login differs, so it's a
# file of its own in conf.d rather than the linked config.toml. It holds the
# whole list (separate files' lists replace, not add to, each other),
# starting with ~/dev/.mise.toml, which every project loads. Without a
# GitHub login it trusts that file alone; if the lookup fails while logged
# in, the file stays as it was.
trust=${XDG_CONFIG_HOME:-$HOME/.config}/mise/conf.d/trust.toml
owners=()
if gh auth status &>/dev/null; then
    owners=(${(u)${(L)${(f)"$( { gh config get -h github.com user; gh api user/orgs --jq '.[].login'; } 2>/dev/null || true)"}}})
fi
if (( ${#owners} )) || [[ ! -e $trust ]]; then
    paths=('"~/dev/.mise.toml"')
    for owner in $owners; do paths+=("\"~/dev/$owner\""); done
    # Built whole, then written: a failure can't leave a half-written file.
    content="# Written by bootstrap: the shared ~/dev config, and repos owned by you
# or your GitHub orgs. Anyone else's clone asks before mise loads its config.
[settings]
trusted_config_paths = [${(j:, :)paths}]"
    mkdir -p "${trust:h}"
    print -r -- "$content" > "$trust"
fi

# Clone your own repos (no forks, no archived) into ~/dev/<owner> as
# projects, with the same command as cloneproject. One bad repo is reported,
# not fatal, and no clone moves the shell (DOTFILES_FOLLOW, lib/follow.zsh).
if gh auth status &>/dev/null; then
    self=$(git -C "$dotfiles" remote get-url origin 2>/dev/null || true)
    failed=()
    for repo in ${(f)"$(gh repo list --source --no-archived --limit 1000 --json nameWithOwner --jq '.[].nameWithOwner')"}; do
        [[ ${self%.git} == *[:/]$repo ]] && continue   # already at ~/.dotfiles
        [[ -d $PROJECT_DIR/${${repo%%/*}:l}/${repo#*/} ]] && continue   # ~/dev/<owner>/<repo>
        (( ${flat[(Ie)$PROJECT_DIR/${repo#*/}]} )) && continue   # not migrated yet
        if previewing; then echo "would clone $repo"; continue; fi
        DOTFILES_FOLLOW=/dev/null mise -C / run project:clone "$repo" || failed+=("$repo")
    done
    if (( ${#failed} )); then echo "Could not clone: ${failed[*]}"; fi
else
    echo "would clone your GitHub repos into $PROJECT_DIR"
fi

# Secrets live in this Mac's Keychain, entered once per machine. The ones
# needed are the ones projects and orgs name (secret get NAME in their mise
# config, at ~/dev/<org>/<repo> or ~/dev/<org> for all of an org's repos).
# Read-only check, so it runs in test runs too.
if command -v security >/dev/null; then
    # No project naming a secret is the usual case on a new Mac: grep finds
    # nothing and exits 1, which pipefail and set -e would turn into a silent
    # failure of the whole task.
    needed=(${(u)${(f)"$({ grep -ho 'secret get [A-Z_][A-Z0-9_]*' \
        $PROJECT_DIR/*/{,*/}{,.}mise{,.local}.toml(N.) /dev/null || true; } | cut -d' ' -f3)"}})
    missing=()
    for name in $needed; do
        "$dotfiles/bin/.local/bin/secret" get "$name" &>/dev/null || missing+=("$name")
    done
    if (( ${#missing} )); then echo "Missing secrets: ${missing[*]}  (add each with: secret set NAME)"; fi
fi
