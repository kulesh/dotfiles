#!/usr/bin/env zsh
#MISE description="Share this Mac's dotfile changes and apply other Macs' changes"
#MISE raw=true  # asks before committing, and opens lazygit on a conflict
set -euo pipefail

# This file lives at <repo>/.mise/tasks/sync
dotfiles=${0:A:h:h:h}
cd "$dotfiles"

rebasing() { [[ -d $(git rev-parse --git-path rebase-merge) || -d $(git rev-parse --git-path rebase-apply) ]]; }

# The commit this Mac last applied with bootstrap, kept in this clone's .git:
# anything newer still needs applying, however it arrived (this sync, a plain
# git pull, or a sync whose bootstrap failed).
applied_file=$(git rev-parse --absolute-git-dir)/dotfiles-applied
applied=$(cat "$applied_file" 2>/dev/null || true)

if rebasing; then
    resumed=true   # a previous sync stopped at a conflict
else
    resumed=false
    # Changes here are mostly tools writing through the links (lazy-lock.json,
    # agent settings, `packages use`). Commit them so they reach the other
    # Macs, or keep them on this Mac for now; the pull goes ahead either way.
    if [[ -n $(git status --porcelain) ]]; then
        # Every file, not a new directory as one line: the list is what you
        # agree to commit, and the commit message names each file.
        git status --short --untracked-files=all
        print -n "Commit these for your other Macs? [Y/n] " >&2
        read -r reply || reply=n
        if [[ $reply != [nN]* ]]; then
            files=(${(f)"$(git status --porcelain --untracked-files=all | cut -c4- | sed 's/.* -> //')"})
            git add --all
            git commit --quiet -m "$(hostname -s): update ${(j:, :)${(u)files[@]:t}}"
            # This Mac's own changes are live here already.
            if [[ $applied == $(git rev-parse HEAD~) ]]; then
                applied=$(git rev-parse HEAD)
                print -r -- "$applied" > "$applied_file"
            fi
        fi
    fi
    git pull --quiet --rebase --autostash || rebasing || exit 1
fi

# Another Mac changed the same lines. Resolve (or abort) in lazygit; once
# nothing is left in conflict, the rebase carries on from here.
conflicts() { git diff --name-only --diff-filter=U; }
while rebasing; do
    if [[ -n $(conflicts) ]]; then
        echo "These files changed here and on another Mac:" >&2
        conflicts | sed 's/^/  /' >&2
        command -v lazygit >/dev/null && lazygit
    fi
    if rebasing && [[ -n $(conflicts) ]]; then
        echo "Sync paused. Resolve the files above (in lazygit, or edit and git add them) and run dsync again." >&2
        exit 1
    fi
    # Continuing either finishes, or stops at the next commit's conflicts.
    if rebasing && ! GIT_EDITOR=true git rebase --continue >/dev/null && [[ -z $(conflicts) ]]; then
        echo "Sync paused: the rebase couldn't continue. Open lazygit to finish it, then run dsync again." >&2
        exit 1
    fi
done

# Aborting the rebase leaves this Mac behind GitHub; a push would be refused.
if ! git merge-base --is-ancestor '@{upstream}' HEAD; then
    echo "Sync stopped: this Mac doesn't have GitHub's changes yet, so nothing was pushed." >&2
    exit 1
fi

if (( $(git rev-list --count '@{upstream}..HEAD') )); then
    git push --quiet
    echo "Pushed this Mac's changes."
fi

# Bootstrap applies what came in: new links, packages, tools, repos.
head=$(git rev-parse HEAD)
if [[ $applied == $head ]]; then
    echo "Already up to date with your other Macs."
    exit 0
fi
if [[ -n $applied ]] && git merge-base --is-ancestor "$applied" HEAD 2>/dev/null; then
    git log --oneline "$applied..HEAD"
fi

# The config can need a newer mise than this Mac has (min_version in
# .mise.toml, a soft floor: an older mise warns and runs). Bring mise up to
# it first, the way mup would, so bootstrap reads the config as written.
autoload -Uz is-at-least
floor=$(awk -F'"' '/^min_version/ { for (i = 2; i <= NF; i += 2) v = $i; print v }' .mise.toml 2>/dev/null || true)
current=$(mise --version 2>/dev/null | cut -d' ' -f1)
if [[ -n $floor && -n $current ]] && ! is-at-least "$floor" "$current"; then
    echo "mise $current is older than the $floor this config needs; upgrading it first."
    mise bootstrap packages upgrade brew:mise --yes
fi

# dsync's job is to make the home match the repo, so mise's "files: apply ~?"
# would only ever be answered yes. A bootstrap you run by hand still asks.
mise bootstrap --yes
print -r -- "$head" > "$applied_file"
